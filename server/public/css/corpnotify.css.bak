:root {
  --cn-bg: #f6f8fb;
  --cn-surface: #ffffff;
  --cn-border: #e6eaf0;
  --cn-ink: #101828;
  --cn-muted: #667085;
  --cn-primary: #2563eb;
  --cn-primary-soft: #eff6ff;
  --cn-danger: #dc2626;
  --cn-success: #16a34a;
  --cn-warning: #d97706;
  --cn-policy: #7c3aed;
}
body { background: var(--cn-bg) !important; color: var(--cn-ink); }
.cn-page { display: grid; gap: 20px; }
.cn-page-header { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
.cn-eyebrow { color: var(--cn-primary); font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.cn-title { margin: 4px 0 4px; font-size: clamp(1.55rem, 2vw, 2rem); font-weight: 750; letter-spacing: -.02em; }
.cn-subtitle { margin: 0; color: var(--cn-muted); max-width: 760px; }
.cn-panel { background: var(--cn-surface); border: 1px solid var(--cn-border); border-radius: 16px; box-shadow: 0 1px 2px rgba(16,24,40,.03); }
.cn-panel-header { padding: 18px 20px; border-bottom: 1px solid var(--cn-border); }
.cn-panel-body { padding: 20px; }
.cn-btn-primary { border-radius: 10px; padding: .65rem 1rem; font-weight: 700; box-shadow: 0 1px 2px rgba(37,99,235,.18); }
.cn-stat-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 12px; }
.cn-stat { padding: 16px; border: 1px solid var(--cn-border); border-radius: 14px; background: #fff; }
.cn-stat-label { color: var(--cn-muted); font-size: .8rem; font-weight: 700; }
.cn-stat-value { margin-top: 4px; font-size: 1.55rem; line-height: 1; font-weight: 800; }
.cn-toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
.cn-search { min-width: 260px; flex: 1 1 320px; }
.cn-table { margin: 0; }
.cn-table thead th { background: #fafbfc; color: #475467; font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .035em; border-bottom-color: var(--cn-border); white-space: nowrap; }
.cn-table tbody td { padding-top: 15px; padding-bottom: 15px; vertical-align: middle; border-color: #eef1f5; }
.cn-table tbody tr:hover { background: #fbfdff; }
.cn-title-cell { font-weight: 750; color: var(--cn-ink); }
.cn-meta { color: var(--cn-muted); font-size: .82rem; }
.cn-badge { display:inline-flex; align-items:center; gap:6px; border-radius:999px; padding:.35rem .58rem; font-size:.75rem; font-weight:800; }
.cn-badge-info { color:#1d4ed8; background:#eff6ff; }
.cn-badge-warning { color:#b45309; background:#fff7ed; }
.cn-badge-critical { color:#b91c1c; background:#fef2f2; }
.cn-badge-policy { color:#6d28d9; background:#f5f3ff; }
.cn-badge-active { color:#15803d; background:#f0fdf4; }
.cn-badge-inactive { color:#667085; background:#f2f4f7; }
.cn-form-grid { display:grid; grid-template-columns: minmax(0,1fr) 340px; gap:20px; align-items:start; }
.cn-section { padding:20px; border-bottom:1px solid var(--cn-border); }
.cn-section:last-child { border-bottom:0; }
.cn-section-title { font-weight:800; margin-bottom:4px; }
.cn-section-help { color:var(--cn-muted); font-size:.86rem; margin-bottom:16px; }
.cn-field-label { font-weight:700; font-size:.9rem; }
.cn-sticky { position:sticky; top:20px; }
.cn-side-note { color:var(--cn-muted); font-size:.86rem; line-height:1.55; }
.cn-detail-grid { display:grid; grid-template-columns:minmax(0,1fr) 320px; gap:20px; }
.cn-kv { display:grid; grid-template-columns:140px minmax(0,1fr); gap:10px 18px; }
.cn-kv dt { color:var(--cn-muted); font-weight:700; }
.cn-kv dd { margin:0; font-weight:600; overflow-wrap:anywhere; }
.cn-empty { text-align:center; padding:54px 20px; color:var(--cn-muted); }
.cn-empty-icon { width:48px; height:48px; margin:0 auto 12px; border-radius:14px; display:grid; place-items:center; background:var(--cn-primary-soft); color:var(--cn-primary); font-size:1.3rem; }
@media (max-width: 991.98px) { .cn-stat-grid{grid-template-columns:repeat(2,1fr)} .cn-form-grid,.cn-detail-grid{grid-template-columns:1fr} .cn-sticky{position:static} }
@media (max-width: 575.98px) { .cn-page-header{flex-direction:column} .cn-stat-grid{grid-template-columns:1fr 1fr} .cn-kv{grid-template-columns:1fr} }

.cn-notifications-page{gap:18px}.cn-count-badge{display:inline-flex;min-width:32px;height:32px;align-items:center;justify-content:center;border-radius:999px;background:#eef2ff;color:#4338ca;font-weight:800;font-size:.85rem;padding:0 .65rem}.cn-notification-overview{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid var(--cn-border);border-radius:14px;background:#fff;overflow:hidden}.cn-overview-item{padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-right:1px solid var(--cn-border)}.cn-overview-item:last-child{border-right:0}.cn-overview-item span{color:var(--cn-muted);font-size:.84rem;font-weight:700}.cn-overview-item strong{font-size:1.15rem}.cn-notification-toolbar-wrap{padding:14px 16px;border-bottom:1px solid var(--cn-border);display:grid;gap:14px}.cn-segmented{display:flex;gap:6px;overflow-x:auto}.cn-segmented-btn{border:0;background:transparent;color:#475467;padding:.55rem .75rem;border-radius:9px;font-weight:700;white-space:nowrap}.cn-segmented-btn span{color:#98a2b3;font-size:.78rem;margin-left:4px}.cn-segmented-btn:hover{background:#f8fafc}.cn-segmented-btn.active{background:#eef4ff;color:#1d4ed8}.cn-segmented-btn:focus-visible,.cn-notification-title:focus-visible,.cn-search-box:focus-within,.cn-create-button:focus-visible{outline:3px solid rgba(37,99,235,.22);outline-offset:2px}
.cn-notification-tools{display:flex;gap:10px;align-items:center}.cn-search-box{display:flex;align-items:center;gap:8px;flex:1;border:1px solid var(--cn-border);border-radius:10px;padding:0 .75rem;background:#fff}.cn-search-box input{border:0;outline:0;width:100%;padding:.65rem 0;background:transparent}.cn-type-select{max-width:170px}.cn-notification-list{display:grid}.cn-notification-item{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:14px;padding:18px 20px;border-bottom:1px solid #edf1f5;background:#fff}.cn-notification-item:last-child{border-bottom:0}.cn-notification-item:hover{background:#fbfdff}.cn-notification-item.is-active{box-shadow:inset 3px 0 0 #2563eb}.cn-notification-item.is-inactive{opacity:.82}.cn-notification-icon{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-weight:900;font-size:.86rem}.cn-notification-icon-info{background:#eff6ff;color:#1d4ed8}.cn-notification-icon-warning{background:#fff7ed;color:#b45309}.cn-notification-icon-critical{background:#fef2f2;color:#b91c1c}.cn-notification-icon-policy{background:#f5f3ff;color:#6d28d9}

.cn-notification-main{min-width:0}.cn-notification-topline{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.cn-notification-title{color:var(--cn-ink);font-weight:800;text-decoration:none;font-size:1rem}.cn-notification-title:hover{color:var(--cn-primary)}.cn-notification-time{color:var(--cn-muted);font-size:.8rem;white-space:nowrap}.cn-notification-description{margin:.45rem 0 .65rem;color:#475467;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.cn-notification-meta-row{display:flex;gap:14px 20px;flex-wrap:wrap;color:var(--cn-muted);font-size:.8rem}.cn-notification-meta-row strong{color:#475467}.cn-status-dot-label{display:inline-flex;align-items:center;gap:6px;color:#475467;font-size:.76rem;font-weight:700}.cn-status-dot-label::before{content:"";width:7px;height:7px;border-radius:50%;background:#98a2b3}.cn-status-dot-label.is-on::before{background:#16a34a}.cn-notification-actions{display:flex;align-items:center;gap:6px;align-self:center}.cn-notification-actions form{margin:0}.cn-pagination-wrap{padding:14px 16px;border-top:1px solid var(--cn-border)}.cn-empty-notifications{padding:64px 20px}
@media (max-width: 991.98px){.cn-notification-overview{grid-template-columns:repeat(2,minmax(0,1fr))}.cn-overview-item:nth-child(2){border-right:0}.cn-overview-item:nth-child(-n+2){border-bottom:1px solid var(--cn-border)}.cn-notification-item{grid-template-columns:40px minmax(0,1fr)}.cn-notification-actions{grid-column:2;justify-content:flex-start}.cn-notification-topline{display:block}.cn-notification-time{display:block;margin-top:5px}.cn-notification-tools{flex-wrap:wrap}.cn-type-select{max-width:none;flex:0 0 180px}}
@media (max-width:575.98px){.cn-notification-overview{grid-template-columns:1fr 1fr}.cn-overview-item{padding:12px}.cn-notification-toolbar-wrap{padding:12px}.cn-notification-tools{display:grid;grid-template-columns:1fr}.cn-type-select{max-width:none;width:100%}.cn-notification-item{grid-template-columns:36px minmax(0,1fr);padding:15px 14px;gap:10px}.cn-notification-icon{width:34px;height:34px;border-radius:10px}.cn-notification-meta-row{display:grid;gap:4px}.cn-notification-actions{grid-column:1 / -1;flex-wrap:wrap}.cn-create-button{width:100%}.cn-page-header{align-items:stretch}}
